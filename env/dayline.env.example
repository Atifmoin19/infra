# Copy to env/dayline.env. Shared by dayline-api, dayline-worker and dayline-beat.
# Keys mirror taskboard/backend/.env.example.
# IMPORTANT: leave unused optional keys COMMENTED OUT, not blank. The app reads them with
# os.getenv(key, default), so `KEY=` yields "" instead of the default (EMAIL_PORT= crashes
# on int(''), CELERY_BROKER_URL= breaks Celery).

# --- Required ---
# Must match env/dayline-db.env. Host is the compose service name.
DATABASE_URL=postgresql://dayline:change-me-db-password@dayline-db:5432/dayline
REDIS_HOST=dayline-redis
REDIS_PORT=6379
# Must match env/dayline-redis.env
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
REDIS_DB_CELERY=1
API_ROOT_PATH=/dayline
# Comma-separated production frontend origins (localhost is always allowed)
FRONTEND_ORIGIN=https://your-dayline-frontend.vercel.app
# Used for the "Open in Dayline" link in notification emails
FRONTEND_APP_URL=https://your-dayline-frontend.vercel.app/
ENVIRONMENT=production

# --- "Try the demo" sandboxes (POST /dayline/demo) ---
DEMO_MODE_ENABLED=false
DEMO_TTL_HOURS=24
DEMO_MAX_PER_IP_PER_HOUR=5
DEMO_MAX_LIVE_WORKSPACES=100
# openssl rand -hex 32
DEMO_IP_SALT=change-me

# --- Timeline ---
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_END_HOUR=19
MAX_OPEN_SESSION_HOURS=12

# --- Celery ---
OVERDUE_SWEEP_INTERVAL_SECONDS=60
# Leave commented: derived from REDIS_HOST/PORT/PASSWORD/DB_CELERY
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# --- Optional: email (SMTP) ---
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=

# --- Optional: Slack / web push / Sentry ---
# SLACK_WEBHOOK_URL=
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_CLAIMS_EMAIL=
# SENTRY_DSN=

# --- Optional: AI insight ---
# GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_MODEL=

# --- Optional: SSO / OIDC ---
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://api.fullstackcity.in/dayline/auth/sso/callback
OIDC_SCOPES=openid email profile
OIDC_PROVIDER_LABEL=Single Sign-On
