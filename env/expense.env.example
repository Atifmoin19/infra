# Copy to env/expense.env. Keys mirror ExpenseTrackerBE/core/config.py.

# --- Required ---
# Must match env/expense-db.env (user / password / db). Host is the compose service name.
DATABASE_URL=postgresql://expense:change-me-db-password@expense-db:5432/expense
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ENV=production
# Comma-separated frontend origins (Vercel domain)
ALLOWED_ORIGINS=https://your-expense-frontend.vercel.app

JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

# --- "Try the demo" sandbox (POST /api/v1/auth/demo); 404 unless true ---
DEMO_MODE_ENABLED=false
DEMO_TTL_HOURS=24
DEMO_RATE_LIMIT_PER_HOUR=5
DEMO_MAX_SESSIONS=200

# --- Optional: email OTP via EmailJS ---
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# --- Optional: Google sign-in ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: Web Push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Optional: S3-compatible object storage (receipts) ---
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
