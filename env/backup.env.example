# Copy to env/backup.env. One BACKUP_<NAME>_URL per database; dumps go to ./backups/<name>/.
BACKUP_EXPENSE_URL=postgresql://expense:change-me-db-password@expense-db:5432/expense
BACKUP_DAYLINE_URL=postgresql://dayline:change-me-db-password@dayline-db:5432/dayline
BACKUP_KEEP_DAYS=7
# HH:MM in UTC (21:00 UTC = 02:30 IST)
BACKUP_AT=21:00
