# Copy to env/portfolio.env and fill in. Keys mirror NextPortfolio/Backend/app/core/config.py.

# --- Required (app refuses to boot without these) ---
ADMIN_ID=your-admin-id
# python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
ADMIN_PASSWORD_HASH=
JWT_SECRET=change-me-to-a-long-random-string
GEMINI_API_KEY=

# --- Optional ---
JWT_EXPIRE_MINUTES=720
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash

# Firebase: FIREBASE_SERVICE_ACCOUNT_PATH is set by docker-compose.yml to the mounted
# secrets/portfolio/firebase-service-account.json. Don't set it here.
# Alternative (no file mount): paste the whole JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

ALLOWED_ORIGINS=https://portfolio.fullstackcity.in,https://portfolio-henna-three-70.vercel.app
# Public base URL of this service (used to build the resume download link)
BACKEND_PUBLIC_URL=https://api.fullstackcity.in/portfolio

# Contact form email via Resend
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=Atif Moin Portfolio <portfolio@fullstackcity.in>
CONTACT_EMAILS_PER_DAY=20
