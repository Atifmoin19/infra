# Compose-level variables for the Oracle VM. Copy to /srv/infra/.env (gitignored).
# Source checkouts live in /srv/src/<service>; override Dockerfiles in /srv/infra/services/.
CADDYFILE=Caddyfile
PORTFOLIO_SRC=/srv/src/portfolio
PORTFOLIO_DOCKERFILE=/srv/infra/services/portfolio/Dockerfile
EXPENSE_SRC=/srv/src/expense
EXPENSE_DOCKERFILE=/srv/infra/services/expense/Dockerfile
DAYLINE_SRC=/srv/src/dayline/backend
DAYLINE_DOCKERFILE=/srv/infra/services/dayline/Dockerfile
